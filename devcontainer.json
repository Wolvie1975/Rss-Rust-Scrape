{
    "name": "Rust Dev Env",
    "image": "rust:1.97-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "vadimcn.vscode-lldb",
                "ms-mssql.mssql",
                "github.copilot",
                "github.copilot-chat",
                "anthropic.claude-code",
                "openai.chatgpt"
            ],
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash",
                "rust-analyzer.check.command": "clippy"
            }
        }
    },
    "remoteUser": "root",
    "containerEnv": {
        "CARGO_HOME": "/workspace/.cargo",
        "SQL_SERVER_HOST": "sql2025,1433"
    },
    "remoteEnv": {
        "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}"
    },
    "runArgs": [
        "--network=dev-bridge"
    ],
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],
    "postCreateCommand": "npm install -g @google/gemini-cli && echo Dev container ready"
}
